{
  "name": "dsh-plugin-undo",
  "version": "0.1.0",
  "description": "Conversation undo for DeepSeek Harness: /undo <n> rewinds the model-visible surface and the Web UI collapses the undone turns.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["dsh-plugin"],
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6"
  }
}
